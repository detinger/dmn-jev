<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="drd_relief" name="Monetary relief (Jev + DMN)" namespace="https://fipu.unipu.hr/jevdmn" exporter="jevdmn" exporterVersion="0.1.0">
  <itemDefinition id="type_relief_holistic" name="t_relief_holistic">
    <typeRef>string</typeRef>
    <allowedValues id="allowed_relief_holistic">
      <text>"relief","no_relief"</text>
    </allowedValues>
  </itemDefinition>
  <decision id="decision_relief_decision" name="Monetary relief">
    <description>Distilled decision table (Decide whether the complaint should be resolved with monetary relief (refund or reimbursement).)</description>
    <variable id="var_relief_decision" name="relief_decision" typeRef="string" />
    <informationRequirement id="ir_unauthorized_to_relief_decision">
      <requiredInput href="#input_unauthorized" />
    </informationRequirement>
    <informationRequirement id="ir_refund_requested_to_relief_decision">
      <requiredInput href="#input_refund_requested" />
    </informationRequirement>
    <authorityRequirement id="ar_ks_teacher_to_relief_decision">
      <requiredAuthority href="#ks_teacher" />
    </authorityRequirement>
    <decisionTable id="table_relief_decision" hitPolicy="UNIQUE">
      <input id="in_relief_decision_0" label="Unauthorized activity">
        <inputExpression id="expr_relief_decision_0" typeRef="boolean">
          <text>unauthorized</text>
        </inputExpression>
      </input>
      <input id="in_relief_decision_1" label="Refund requested">
        <inputExpression id="expr_relief_decision_1" typeRef="boolean">
          <text>refund_requested</text>
        </inputExpression>
      </input>
      <output id="out_relief_decision" name="relief_decision" label="Monetary relief" typeRef="string">
        <outputValues id="ov_relief_decision">
          <text>"no_relief","relief"</text>
        </outputValues>
      </output>
      <annotation name="Support" />
      <annotation name="Purity" />
      <rule id="rule_relief_decision_1">
        <inputEntry id="ie_relief_decision_1_0">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ie_relief_decision_1_1">
          <text>false</text>
        </inputEntry>
        <outputEntry id="oe_relief_decision_1">
          <text>"no_relief"</text>
        </outputEntry>
        <annotationEntry>
          <text>3804</text>
        </annotationEntry>
        <annotationEntry>
          <text>0.848</text>
        </annotationEntry>
      </rule>
      <rule id="rule_relief_decision_2">
        <inputEntry id="ie_relief_decision_2_0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="ie_relief_decision_2_1">
          <text>true</text>
        </inputEntry>
        <outputEntry id="oe_relief_decision_2">
          <text>"no_relief"</text>
        </outputEntry>
        <annotationEntry>
          <text>863</text>
        </annotationEntry>
        <annotationEntry>
          <text>0.584</text>
        </annotationEntry>
      </rule>
      <rule id="rule_relief_decision_3">
        <inputEntry id="ie_relief_decision_3_0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="ie_relief_decision_3_1">
          <text>true</text>
        </inputEntry>
        <outputEntry id="oe_relief_decision_3">
          <text>"relief"</text>
        </outputEntry>
        <annotationEntry>
          <text>132</text>
        </annotationEntry>
        <annotationEntry>
          <text>0.758</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_relief_gate" name="Confidence gate">
    <description>Data-derived confidence gate</description>
    <variable id="var_relief_gate" name="relief_gate" typeRef="string" />
    <authorityRequirement id="ar_ks_calibration_to_relief_gate">
      <requiredAuthority href="#ks_calibration" />
    </authorityRequirement>
    <decisionTable id="table_relief_gate" hitPolicy="UNIQUE">
      <output id="out_relief_gate" name="relief_gate" label="Confidence gate" typeRef="string">
        <outputValues id="ov_relief_gate">
          <text>"auto","review"</text>
        </outputValues>
      </output>
      <annotation name="Support" />
      <annotation name="Purity" />
      <rule id="rule_relief_gate_1">
        <outputEntry id="oe_relief_gate_1">
          <text>"review"</text>
        </outputEntry>
        <annotationEntry>
          <text>800</text>
        </annotationEntry>
        <annotationEntry>
          <text>0.801</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_relief_route" name="Automate or review">
    <description>Automate only if the gate accepts and the table agrees with Jev</description>
    <variable id="var_relief_route" name="relief_route" typeRef="string" />
    <informationRequirement id="ir_relief_decision_to_relief_route">
      <requiredDecision href="#decision_relief_decision" />
    </informationRequirement>
    <informationRequirement id="ir_relief_gate_to_relief_route">
      <requiredDecision href="#decision_relief_gate" />
    </informationRequirement>
    <informationRequirement id="ir_relief_holistic_to_relief_route">
      <requiredInput href="#input_relief_holistic" />
    </informationRequirement>
    <decisionTable id="table_relief_route" hitPolicy="UNIQUE">
      <input id="in_relief_route_0" label="Confidence gate">
        <inputExpression id="expr_relief_route_0" typeRef="string">
          <text>relief_gate</text>
        </inputExpression>
        <inputValues id="iv_relief_route_0">
          <text>"auto","review"</text>
        </inputValues>
      </input>
      <input id="in_relief_route_1" label="Table agrees with Jev">
        <inputExpression id="expr_relief_route_1" typeRef="boolean">
          <text>relief_decision = relief_holistic</text>
        </inputExpression>
      </input>
      <output id="out_relief_route" name="relief_route" label="Automate or review" typeRef="string">
        <outputValues id="ov_relief_route">
          <text>"automatic","manual"</text>
        </outputValues>
      </output>
      <annotation name="Support" />
      <annotation name="Purity" />
      <rule id="rule_relief_route_1">
        <inputEntry id="ie_relief_route_1_0">
          <text>"auto"</text>
        </inputEntry>
        <inputEntry id="ie_relief_route_1_1">
          <text>true</text>
        </inputEntry>
        <outputEntry id="oe_relief_route_1">
          <text>"automatic"</text>
        </outputEntry>
        <annotationEntry>
          <text>0</text>
        </annotationEntry>
        <annotationEntry>
          <text />
        </annotationEntry>
      </rule>
      <rule id="rule_relief_route_2">
        <inputEntry id="ie_relief_route_2_0">
          <text>"auto"</text>
        </inputEntry>
        <inputEntry id="ie_relief_route_2_1">
          <text>false</text>
        </inputEntry>
        <outputEntry id="oe_relief_route_2">
          <text>"manual"</text>
        </outputEntry>
        <annotationEntry>
          <text>0</text>
        </annotationEntry>
        <annotationEntry>
          <text />
        </annotationEntry>
      </rule>
      <rule id="rule_relief_route_3">
        <inputEntry id="ie_relief_route_3_0">
          <text>"review"</text>
        </inputEntry>
        <inputEntry id="ie_relief_route_3_1">
          <text>-</text>
        </inputEntry>
        <outputEntry id="oe_relief_route_3">
          <text>"manual"</text>
        </outputEntry>
        <annotationEntry>
          <text>0</text>
        </annotationEntry>
        <annotationEntry>
          <text />
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <inputData id="input_unauthorized" name="Unauthorized activity">
    <description>Jev typed answer to: The consumer says that a transaction, charge, withdrawal, or account was made without their permission.</description>
    <variable id="var_unauthorized" name="unauthorized" typeRef="boolean" />
  </inputData>
  <inputData id="input_refund_requested" name="Refund requested">
    <description>Jev typed answer to: The consumer asks the company for a refund, a reimbursement, a credit to their account, or the return of their money.</description>
    <variable id="var_refund_requested" name="refund_requested" typeRef="boolean" />
  </inputData>
  <inputData id="input_relief_holistic" name="Jev decision (Monetary relief)">
    <description>Jev holistic answer to: Based on the complaint, the company should refund or reimburse money to the consumer.</description>
    <variable id="var_relief_holistic" name="relief_holistic" typeRef="t_relief_holistic" />
  </inputData>
  <knowledgeSource id="ks_teacher" name="Jev (simulated-0) holistic decisions">
    <description>Rules distilled from Jev decisions on 4799 unlabelled cases (decision tree, merged rules).</description>
  </knowledgeSource>
  <knowledgeSource id="ks_calibration" name="Labelled calibration set">
    <description>Gate learned on half of the calibration set; threshold by Learn-then-Test at eps=0.05, delta=0.05.</description>
  </knowledgeSource>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1">
      <dmndi:DMNShape id="shape_decision_relief_route" dmnElementRef="decision_relief_route">
        <dc:Bounds x="210" y="0" width="180" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="shape_decision_relief_decision" dmnElementRef="decision_relief_decision">
        <dc:Bounds x="105" y="200" width="180" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="shape_decision_relief_gate" dmnElementRef="decision_relief_gate">
        <dc:Bounds x="315" y="200" width="180" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="shape_input_unauthorized" dmnElementRef="input_unauthorized">
        <dc:Bounds x="0" y="400" width="180" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="shape_input_refund_requested" dmnElementRef="input_refund_requested">
        <dc:Bounds x="210" y="400" width="180" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="shape_input_relief_holistic" dmnElementRef="input_relief_holistic">
        <dc:Bounds x="420" y="400" width="180" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="shape_ks_teacher" dmnElementRef="ks_teacher">
        <dc:Bounds x="660" y="200" width="180" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="shape_ks_calibration" dmnElementRef="ks_calibration">
        <dc:Bounds x="870" y="200" width="180" height="80" />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="edge_ir_unauthorized_to_relief_decision" dmnElementRef="ir_unauthorized_to_relief_decision">
        <di:waypoint x="90" y="400" />
        <di:waypoint x="195" y="280" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="edge_ir_refund_requested_to_relief_decision" dmnElementRef="ir_refund_requested_to_relief_decision">
        <di:waypoint x="300" y="400" />
        <di:waypoint x="195" y="280" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="edge_ar_ks_teacher_to_relief_decision" dmnElementRef="ar_ks_teacher_to_relief_decision">
        <di:waypoint x="660" y="240" />
        <di:waypoint x="285" y="240" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="edge_ar_ks_calibration_to_relief_gate" dmnElementRef="ar_ks_calibration_to_relief_gate">
        <di:waypoint x="870" y="240" />
        <di:waypoint x="495" y="240" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="edge_ir_relief_decision_to_relief_route" dmnElementRef="ir_relief_decision_to_relief_route">
        <di:waypoint x="195" y="200" />
        <di:waypoint x="300" y="80" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="edge_ir_relief_gate_to_relief_route" dmnElementRef="ir_relief_gate_to_relief_route">
        <di:waypoint x="405" y="200" />
        <di:waypoint x="300" y="80" />
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="edge_ir_relief_holistic_to_relief_route" dmnElementRef="ir_relief_holistic_to_relief_route">
        <di:waypoint x="510" y="400" />
        <di:waypoint x="300" y="80" />
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>