<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="drd_jobfraud" name="Fraudulent posting (Jev + DMN)" namespace="https://fipu.unipu.hr/jevdmn" exporter="jevdmn" exporterVersion="0.1.0">
  <itemDefinition id="type_job_category" name="t_job_category">
    <typeRef>string</typeRef>
    <allowedValues id="allowed_job_category">
      <text>"admin","customer_service","sales_marketing","it_engineering","healthcare","finance","energy_industry","hospitality","other"</text>
    </allowedValues>
  </itemDefinition>
  <itemDefinition id="type_fraud_holistic" name="t_fraud_holistic">
    <typeRef>string</typeRef>
    <allowedValues id="allowed_fraud_holistic">
      <text>"fraudulent","legitimate"</text>
    </allowedValues>
  </itemDefinition>
  <decision id="decision_jobfraud_decision" name="Fraudulent posting">
    <description>Distilled decision table (Decide whether a job posting is fraudulent and should be removed.)</description>
    <variable id="var_jobfraud_decision" name="jobfraud_decision" typeRef="string" />
    <informationRequirement id="ir_job_category_to_jobfraud_decision">
      <requiredInput href="#input_job_category" />
    </informationRequirement>
    <informationRequirement id="ir_company_described_to_jobfraud_decision">
      <requiredInput href="#input_company_described" />
    </informationRequirement>
    <informationRequirement id="ir_company_named_to_jobfraud_decision">
      <requiredInput href="#input_company_named" />
    </informationRequirement>
    <informationRequirement id="ir_remote_work_to_jobfraud_decision">
      <requiredInput href="#input_remote_work" />
    </informationRequirement>
    <informationRequirement id="ir_pay_stated_to_jobfraud_decision">
      <requiredInput href="#input_pay_stated" />
    </informationRequirement>
    <informationRequirement id="ir_easy_money_to_jobfraud_decision">
      <requiredInput href="#input_easy_money" />
    </informationRequirement>
    <informationRequirement id="ir_requirements_listed_to_jobfraud_decision">
      <requiredInput href="#input_requirements_listed" />
    </informationRequirement>
    <informationRequirement id="ir_benefits_listed_to_jobfraud_decision">
      <requiredInput href="#input_benefits_listed" />
    </informationRequirement>
    <informationRequirement id="ir_offplatform_contact_to_jobfraud_decision">
      <requiredInput href="#input_offplatform_contact" />
    </informationRequirement>
    <informationRequirement id="ir_duties_specificity_to_jobfraud_decision">
      <requiredInput href="#input_duties_specificity" />
    </informationRequirement>
    <informationRequirement id="ir_writing_quality_to_jobfraud_decision">
      <requiredInput href="#input_writing_quality" />
    </informationRequirement>
    <authorityRequirement id="ar_ks_teacher_to_jobfraud_decision">
      <requiredAuthority href="#ks_teacher" />
    </authorityRequirement>
    <decisionTable id="table_jobfraud_decision" hitPolicy="UNIQUE">
      <input id="in_jobfraud_decision_0" label="Job category">
        <inputExpression id="expr_jobfraud_decision_0" typeRef="string">
          <text>job_category</text>
        </inputExpression>
        <inputValues id="iv_jobfraud_decision_0">
          <text>"admin","customer_service","sales_marketing","it_engineering","healthcare","finance","energy_industry","hospitality","other"</text>
        </inputValues>
      </input>
      <input id="in_jobfraud_decision_1" label="Company described">
        <inputExpression id="expr_jobfraud_decision_1" typeRef="boolean">
          <text>company_described</text>
        </inputExpression>
      </input>
      <input id="in_jobfraud_decision_2" label="Company named">
        <inputExpression id="expr_jobfraud_decision_2" typeRef="boolean">
          <text>company_named</text>
        </inputExpression>
      </input>
      <input id="in_jobfraud_decision_3" label="Remote work">
        <inputExpression id="expr_jobfraud_decision_3" typeRef="boolean">
          <text>remote_work</text>
        </inputExpression>
      </input>
      <input id="in_jobfraud_decision_4" label="Pay stated">
        <inputExpression id="expr_jobfraud_decision_4" typeRef="boolean">
          <text>pay_stated</text>
        </inputExpression>
      </input>
      <input id="in_jobfraud_decision_5" label="Easy money">
        <inputExpression id="expr_jobfraud_decision_5" typeRef="boolean">
          <text>easy_money</text>
        </inputExpression>
      </input>
      <input id="in_jobfraud_decision_6" label="Requirements listed">
        <inputExpression id="expr_jobfraud_decision_6" typeRef="boolean">
          <text>requirements_listed</text>
        </inputExpression>
      </input>
      <input id="in_jobfraud_decision_7" label="Benefits listed">
        <inputExpression id="expr_jobfraud_decision_7" typeRef="boolean">
          <text>benefits_listed</text>
        </inputExpression>
      </input>
      <input id="in_jobfraud_decision_8" label="Off-platform contact">
        <inputExpression id="expr_jobfraud_decision_8" typeRef="boolean">
          <text>offplatform_contact</text>
        </inputExpression>
      </input>
      <input id="in_jobfraud_decision_9" label="Specific duties">
        <inputExpression id="expr_jobfraud_decision_9" typeRef="number">
          <text>duties_specificity</text>
        </inputExpression>
      </input>
      <input id="in_jobfraud_decision_10" label="Writing quality">
        <inputExpression id="expr_jobfraud_decision_10" typeRef="number">
          <text>writing_quality</text>
        </inputExpression>
      </input>
      <output id="out_jobfraud_decision" name="jobfraud_decision" label="Fraudulent posting" typeRef="string">
        <outputValues id="ov_jobfraud_decision">
          <text>"fraudulent","legitimate"</text>
        </outputValues>
      </output>
      <annotation name="Support" />
      <annotation name="Purity" />
      <rule id="rule_jobfraud_decision_1">
        <inputEntry id="ie_jobfraud_decision_1_0">
          <text>not("admin","customer_service","energy_industry")</text>
        </inputEntry>
        <inputEntry id="ie_jobfraud_decision_1_1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="ie_jobfraud_decision_1_2">
          <text>false</text>
        </inputEntry>
        <inputEntry id="ie_jobfraud_decision_1_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="ie_jobfraud_decision_1_4">
          <text>-</text>
        </inputEntry>
