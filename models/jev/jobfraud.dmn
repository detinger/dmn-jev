        </inputEntry>
        <inputEntry id="ie_jobfraud_decision_1_9">
          <text>&gt;= 2</text>
        </inputEntry>
        <inputEntry id="ie_jobfraud_decision_1_10">
          <text>&lt;= 1</text>
        </inputEntry>
        <outputEntry id="oe_jobfraud_decision_1">
          <text>"fraudulent"</text>
        </outputEntry>
        <annotationEntry>
          <text>341</text>
        </annotationEntry>
        <annotationEntry>
