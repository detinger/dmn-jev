  <inputData id="input_job_category" name="Job category">
    <description>Jev typed answer to: Which kind of job does the posting offer?</description>
    <variable id="var_job_category" name="job_category" typeRef="t_job_category" />
  </inputData>
  <inputData id="input_company_described" name="Company described">
    <description>Jev typed answer to: The posting describes the hiring company, such as what it does, its history, or its products.</description>
    <variable id="var_company_described" name="company_described" typeRef="boolean" />
  </inputData>
  <inputData id="input_company_named" name="Company named">
    <description>Jev typed answer to: The posting names the company that is hiring.</description>
    <variable id="var_company_named" name="company_named" typeRef="boolean" />
  </inputData>
  <inputData id="input_remote_work" name="Remote work">
    <description>Jev typed answer to: The posting says the job can be done from home or remotely.</description>
    <variable id="var_remote_work" name="remote_work" typeRef="boolean" />
  </inputData>
  <inputData id="input_pay_stated" name="Pay stated">
    <description>Jev typed answer to: The posting states the pay, such as a salary, an hourly rate, or a pay range.</description>
    <variable id="var_pay_stated" name="pay_stated" typeRef="boolean" />
  </inputData>
  <inputData id="input_easy_money" name="Easy money">
    <description>Jev typed answer to: The posting promises high pay, fast money, or large earnings for little work.</description>
    <variable id="var_easy_money" name="easy_money" typeRef="boolean" />
  </inputData>
  <inputData id="input_requirements_listed" name="Requirements listed">
    <description>Jev typed answer to: The posting lists specific skills, education, or experience that applicants must have.</description>
    <variable id="var_requirements_listed" name="requirements_listed" typeRef="boolean" />
  </inputData>
  <inputData id="input_benefits_listed" name="Benefits listed">
    <description>Jev typed answer to: The posting lists employee benefits, such as health insurance, paid leave, or a retirement plan.</description>
    <variable id="var_benefits_listed" name="benefits_listed" typeRef="boolean" />
  </inputData>
  <inputData id="input_offplatform_contact" name="Off-platform contact">
    <description>Jev typed answer to: The posting tells applicants to apply or make contact through a personal email address, a text message, or a messaging app.</description>
    <variable id="var_offplatform_contact" name="offplatform_contact" typeRef="boolean" />
  </inputData>
  <inputData id="input_duties_specificity" name="Specific duties">
    <description>Jev typed answer to: How specifically does the posting describe the duties of the job?</description>
    <variable id="var_duties_specificity" name="duties_specificity" typeRef="number" />
  </inputData>
  <inputData id="input_writing_quality" name="Writing quality">
    <description>Jev typed answer to: How well is the posting written?</description>
    <variable id="var_writing_quality" name="writing_quality" typeRef="number" />
  </inputData>
  <inputData id="input_fraud_holistic" name="Jev decision (Fraudulent posting)">
    <description>Jev holistic answer to: The job posting is fraudulent, meaning it is a scam or a fake job rather than a genuine job offer.</description>
    <variable id="var_fraud_holistic" name="fraud_holistic" typeRef="t_fraud_holistic" />
  </inputData>
  <knowledgeSource id="ks_teacher" name="Jev (jev-1.13.0) holistic decisions">
    <description>Rules distilled from Jev decisions on 8736 unlabelled cases (decision tree, merged rules).</description>
  </knowledgeSource>
  <knowledgeSource id="ks_calibration" name="Labelled calibration set">
    <description>Gate learned on half of the calibration set; threshold by Learn-then-Test at eps=0.05, delta=0.05.</description>
  </knowledgeSource>
