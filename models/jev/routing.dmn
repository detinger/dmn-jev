<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="drd_routing" name="Handling queue (Jev + DMN)" namespace="https://fipu.unipu.hr/jevdmn" exporter="jevdmn" exporterVersion="0.1.0">
  <itemDefinition id="type_product" name="t_product">
    <typeRef>string</typeRef>
    <allowedValues id="allowed_product">
      <text>"credit_report","debt_collection","bank_account","credit_card","prepaid_card","money_transfer","mortgage","vehicle_loan","student_loan","personal_loan","other"</text>
    </allowedValues>
  </itemDefinition>
  <itemDefinition id="type_queue_holistic" name="t_queue_holistic">
    <typeRef>string</typeRef>
    <allowedValues id="allowed_queue_holistic">
      <text>"credit_reporting","debt_collection","deposits","cards","payments","mortgage","consumer_loans","fraud"</text>
    </allowedValues>
  </itemDefinition>
  <decision id="decision_routing_decision" name="Handling queue">
    <description>Distilled decision table (Route the complaint to the team that handles it.)</description>
    <variable id="var_routing_decision" name="routing_decision" typeRef="string" />
    <informationRequirement id="ir_product_to_routing_decision">
      <requiredInput href="#input_product" />
    </informationRequirement>
    <informationRequirement id="ir_unauthorized_to_routing_decision">
      <requiredInput href="#input_unauthorized" />
    </informationRequirement>
    <informationRequirement id="ir_identity_theft_to_routing_decision">
      <requiredInput href="#input_identity_theft" />
    </informationRequirement>
    <informationRequirement id="ir_scam_to_routing_decision">
      <requiredInput href="#input_scam" />
    </informationRequirement>
    <informationRequirement id="ir_report_dispute_to_routing_decision">
      <requiredInput href="#input_report_dispute" />
    </informationRequirement>
    <informationRequirement id="ir_collector_contact_to_routing_decision">
      <requiredInput href="#input_collector_contact" />
    </informationRequirement>
    <informationRequirement id="ir_money_lost_to_routing_decision">
      <requiredInput href="#input_money_lost" />
    </informationRequirement>
    <informationRequirement id="ir_fee_or_interest_to_routing_decision">
      <requiredInput href="#input_fee_or_interest" />
    </informationRequirement>
    <informationRequirement id="ir_prior_contact_to_routing_decision">
      <requiredInput href="#input_prior_contact" />
    </informationRequirement>
    <informationRequirement id="ir_claim_denied_to_routing_decision">
      <requiredInput href="#input_claim_denied" />
    </informationRequirement>
    <informationRequirement id="ir_harm_to_routing_decision">
      <requiredInput href="#input_harm" />
    </informationRequirement>
    <authorityRequirement id="ar_ks_teacher_to_routing_decision">
      <requiredAuthority href="#ks_teacher" />
    </authorityRequirement>
    <decisionTable id="table_routing_decision" hitPolicy="UNIQUE">
      <input id="in_routing_decision_0" label="Product">
        <inputExpression id="expr_routing_decision_0" typeRef="string">
          <text>product</text>
        </inputExpression>
        <inputValues id="iv_routing_decision_0">
          <text>"credit_report","debt_collection","bank_account","credit_card","prepaid_card","money_transfer","mortgage","vehicle_loan","student_loan","personal_loan","other"</text>
        </inputValues>
      </input>
      <input id="in_routing_decision_1" label="Unauthorized activity">
        <inputExpression id="expr_routing_decision_1" typeRef="boolean">
          <text>unauthorized</text>
        </inputExpression>
      </input>
      <input id="in_routing_decision_2" label="Identity theft">
        <inputExpression id="expr_routing_decision_2" typeRef="boolean">
          <text>identity_theft</text>
        </inputExpression>
      </input>
      <input id="in_routing_decision_3" label="Scam victim">
        <inputExpression id="expr_routing_decision_3" typeRef="boolean">
          <text>scam</text>
        </inputExpression>
      </input>
      <input id="in_routing_decision_4" label="Credit report dispute">
        <inputExpression id="expr_routing_decision_4" typeRef="boolean">
          <text>report_dispute</text>
        </inputExpression>
      </input>
      <input id="in_routing_decision_5" label="Collector contact">
        <inputExpression id="expr_routing_decision_5" typeRef="boolean">
          <text>collector_contact</text>
        </inputExpression>
      </input>
      <input id="in_routing_decision_6" label="Money lost">
        <inputExpression id="expr_routing_decision_6" typeRef="boolean">
          <text>money_lost</text>
        </inputExpression>
      </input>
      <input id="in_routing_decision_7" label="Fee or interest">
        <inputExpression id="expr_routing_decision_7" typeRef="boolean">
          <text>fee_or_interest</text>
        </inputExpression>
      </input>
      <input id="in_routing_decision_8" label="Prior contact">
        <inputExpression id="expr_routing_decision_8" typeRef="boolean">
          <text>prior_contact</text>
        </inputExpression>
      </input>
      <input id="in_routing_decision_9" label="Claim denied">
        <inputExpression id="expr_routing_decision_9" typeRef="boolean">
          <text>claim_denied</text>
        </inputExpression>
      </input>
      <input id="in_routing_decision_10" label="Financial harm">
        <inputExpression id="expr_routing_decision_10" typeRef="number">
          <text>harm</text>
        </inputExpression>
      </input>
      <output id="out_routing_decision" name="routing_decision" label="Handling queue" typeRef="string">
        <outputValues id="ov_routing_decision">
          <text>"cards","consumer_loans","credit_reporting","debt_collection","deposits","fraud","mortgage","payments"</text>
