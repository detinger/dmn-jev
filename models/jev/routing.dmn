  <decision id="decision_routing_gate" name="Confidence gate">
    <description>Data-derived confidence gate</description>
    <variable id="var_routing_gate" name="routing_gate" typeRef="string" />
    <authorityRequirement id="ar_ks_calibration_to_routing_gate">
      <requiredAuthority href="#ks_calibration" />
    </authorityRequirement>
    <decisionTable id="table_routing_gate" hitPolicy="UNIQUE">
      <output id="out_routing_gate" name="routing_gate" label="Confidence gate" typeRef="string">
        <outputValues id="ov_routing_gate">
          <text>"auto","review"</text>
        </outputValues>
      </output>
      <annotation name="Support" />
      <annotation name="Purity" />
      <rule id="rule_routing_gate_1">
        <outputEntry id="oe_routing_gate_1">
          <text>"review"</text>
        </outputEntry>
        <annotationEntry>
          <text>1000</text>
        </annotationEntry>
        <annotationEntry>
          <text>0.715</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="decision_routing_route" name="Automate or review">
    <description>Automate only if the gate accepts and the table agrees with Jev</description>
    <variable id="var_routing_route" name="routing_route" typeRef="string" />
    <informationRequirement id="ir_routing_decision_to_routing_route">
      <requiredDecision href="#decision_routing_decision" />
    </informationRequirement>
    <informationRequirement id="ir_routing_gate_to_routing_route">
      <requiredDecision href="#decision_routing_gate" />
    </informationRequirement>
    <informationRequirement id="ir_queue_holistic_to_routing_route">
      <requiredInput href="#input_queue_holistic" />
    </informationRequirement>
    <decisionTable id="table_routing_route" hitPolicy="UNIQUE">
      <input id="in_routing_route_0" label="Confidence gate">
        <inputExpression id="expr_routing_route_0" typeRef="string">
          <text>routing_gate</text>
        </inputExpression>
        <inputValues id="iv_routing_route_0">
          <text>"auto","review"</text>
        </inputValues>
      </input>
      <input id="in_routing_route_1" label="Table agrees with Jev">
        <inputExpression id="expr_routing_route_1" typeRef="boolean">
          <text>routing_decision = queue_holistic</text>
        </inputExpression>
      </input>
      <output id="out_routing_route" name="routing_route" label="Automate or review" typeRef="string">
        <outputValues id="ov_routing_route">
          <text>"automatic","manual"</text>
        </outputValues>
      </output>
      <annotation name="Support" />
      <annotation name="Purity" />
      <rule id="rule_routing_route_1">
        <inputEntry id="ie_routing_route_1_0">
          <text>"auto"</text>
        </inputEntry>
        <inputEntry id="ie_routing_route_1_1">
          <text>true</text>
        </inputEntry>
        <outputEntry id="oe_routing_route_1">
          <text>"automatic"</text>
        </outputEntry>
        <annotationEntry>
          <text>0</text>
        </annotationEntry>
        <annotationEntry>
          <text />
        </annotationEntry>
      </rule>
      <rule id="rule_routing_route_2">
        <inputEntry id="ie_routing_route_2_0">
          <text>"auto"</text>
        </inputEntry>
        <inputEntry id="ie_routing_route_2_1">
          <text>false</text>
        </inputEntry>
        <outputEntry id="oe_routing_route_2">
          <text>"manual"</text>
        </outputEntry>
        <annotationEntry>
          <text>0</text>
        </annotationEntry>
        <annotationEntry>
          <text />
        </annotationEntry>
      </rule>
      <rule id="rule_routing_route_3">
        <inputEntry id="ie_routing_route_3_0">
          <text>"review"</text>
        </inputEntry>
        <inputEntry id="ie_routing_route_3_1">
          <text>-</text>
        </inputEntry>
        <outputEntry id="oe_routing_route_3">
          <text>"manual"</text>
        </outputEntry>
        <annotationEntry>
          <text>0</text>
        </annotationEntry>
        <annotationEntry>
          <text />
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <inputData id="input_product" name="Product">
    <description>Jev typed answer to: Which financial product or service is the complaint mainly about?</description>
    <variable id="var_product" name="product" typeRef="t_product" />
  </inputData>
  <inputData id="input_unauthorized" name="Unauthorized activity">
    <description>Jev typed answer to: The consumer says that someone else made a transaction, charge, or withdrawal, or opened an account, without the consumer's permission. A dispute about a purchase the consumer made themselves does not count.</description>
    <variable id="var_unauthorized" name="unauthorized" typeRef="boolean" />
  </inputData>
  <inputData id="input_identity_theft" name="Identity theft">
    <description>Jev typed answer to: The consumer says they are a victim of identity theft, meaning someone used their personal information to open an account, take a loan, or create a debt in their name.</description>
    <variable id="var_identity_theft" name="identity_theft" typeRef="boolean" />
  </inputData>
  <inputData id="input_scam" name="Scam victim">
    <description>Jev typed answer to: The consumer says a scammer tricked them into sending money or giving access to their account.</description>
    <variable id="var_scam" name="scam" typeRef="boolean" />
  </inputData>
  <inputData id="input_report_dispute" name="Credit report dispute">
    <description>Jev typed answer to: The consumer disputes information that appears on their credit report.</description>
    <variable id="var_report_dispute" name="report_dispute" typeRef="boolean" />
  </inputData>
  <inputData id="input_collector_contact" name="Collector contact">
    <description>Jev typed answer to: The consumer complains about calls, letters, or other contact from a debt collector.</description>
    <variable id="var_collector_contact" name="collector_contact" typeRef="boolean" />
  </inputData>
  <inputData id="input_money_lost" name="Money lost">
    <description>Jev typed answer to: The consumer says they lost money or were charged money that they believe they should not have paid.</description>
    <variable id="var_money_lost" name="money_lost" typeRef="boolean" />
  </inputData>
  <inputData id="input_fee_or_interest" name="Fee or interest">
    <description>Jev typed answer to: The complaint is about a fee, a penalty, or an interest charge.</description>
    <variable id="var_fee_or_interest" name="fee_or_interest" typeRef="boolean" />
  </inputData>
  <inputData id="input_prior_contact" name="Prior contact">
    <description>Jev typed answer to: The consumer says they contacted the company about this problem before filing this complaint.</description>
    <variable id="var_prior_contact" name="prior_contact" typeRef="boolean" />
  </inputData>
  <inputData id="input_claim_denied" name="Claim denied">
    <description>Jev typed answer to: The consumer says the company denied or rejected their dispute, claim, or request.</description>
    <variable id="var_claim_denied" name="claim_denied" typeRef="boolean" />
  </inputData>
  <inputData id="input_harm" name="Financial harm">
    <description>Jev typed answer to: How much financial harm does the consumer describe?</description>
    <variable id="var_harm" name="harm" typeRef="number" />
  </inputData>
  <inputData id="input_queue_holistic" name="Jev decision (Handling queue)">
    <description>Jev holistic answer to: Which team should handle this complaint?</description>
    <variable id="var_queue_holistic" name="queue_holistic" typeRef="t_queue_holistic" />
  </inputData>
  <knowledgeSource id="ks_teacher" name="Jev (jev-1.13.0) holistic decisions">
    <description>Rules distilled from Jev decisions on 6000 unlabelled cases (decision tree, merged rules).</description>
  </knowledgeSource>
  <knowledgeSource id="ks_calibration" name="Labelled calibration set">
    <description>Gate learned on half of the calibration set; threshold by Learn-then-Test at eps=0.05, delta=0.05.</description>
  </knowledgeSource>
